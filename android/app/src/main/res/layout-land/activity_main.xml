<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_void">

    <!-- HOME: brand + settings on the left, primary action on the right. -->
    <ScrollView
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lens_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/wordmark"
                    android:textAppearance="@style/TextAppearance.PhoneCam.Wordmark"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tagline"
                android:textAppearance="@style/TextAppearance.PhoneCam.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <View
                    android:id="@+id/homeStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/homeStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/home_status_not_connected"
                    android:textAppearance="@style/TextAppearance.PhoneCam.Title" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quality_label"
                    android:textAppearance="@style/TextAppearance.PhoneCam.Label" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/quality_fps"
                    android:textColor="@color/pc_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/qualityToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_quality_group"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qualityHigh"
                    style="@style/Widget.PhoneCam.Quality"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/quality_high" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qualityMedium"
                    style="@style/Widget.PhoneCam.Quality"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/quality_medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qualityLow"
                    style="@style/Widget.PhoneCam.Quality"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/quality_low" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanConnectButton"
                style="@style/Widget.PhoneCam.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_scan_connect"
                app:icon="@drawable/ic_qr_scan"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exitButton"
                style="@style/Widget.PhoneCam.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/btn_exit" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <!-- SCAN -->
    <FrameLayout
        android:id="@+id/scanContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pc_void"
        android:visibility="gone"
        tools:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/scanPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:layout_width="@dimen/scan_reticle_size"
            android:layout_height="@dimen/scan_reticle_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_scan_reticle" />

        <TextView
            android:id="@+id/scanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_scrim_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/scan_hint"
            android:textAppearance="@style/TextAppearance.PhoneCam.Title"
            android:textColor="@color/pc_paper" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanCancelButton"
            style="@style/Widget.PhoneCam.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="20dp"
            android:minWidth="140dp"
            android:text="@string/btn_cancel" />
    </FrameLayout>

    <!-- LIVE: monitor on the left, controls on a narrow rail. -->
    <LinearLayout
        android:id="@+id/liveContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="gone">

        <FrameLayout
            android:id="@+id/liveStage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/previewCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/pc_panel"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pc_line"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/livePreview"
                        android:layout_width="320dp"
                        android:layout_height="180dp"
                        android:contentDescription="@string/preview_content_description" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_viewfinder" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/previewHiddenHint"
                style="@style/Widget.PhoneCam.ChipHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/preview_hidden_hint"
                android:visibility="gone" />
        </FrameLayout>

        <ScrollView
            android:layout_width="@dimen/live_rail_width"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/liveRecBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_rec_dot" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="0.16"
                            android:text="@string/live_badge"
                            android:textAllCaps="true"
                            android:textColor="@color/pc_tally"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/liveConnectingProgress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:indeterminateTint="@color/pc_tungsten"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/liveStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.PhoneCam.Title"
                    tools:text="arch" />

                <TextView
                    android:id="@+id/liveQualityCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:textColor="@color/pc_dim"
                    android:textSize="12sp"
                    tools:text="720p · 30" />

                <TextView
                    android:id="@+id/liveBatteryHint"
                    style="@style/Widget.PhoneCam.ChipHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/live_battery_hint"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previewToggleButton"
                    style="@style/Widget.PhoneCam.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_hide_preview"
                    android:visibility="gone"
                    app:icon="@drawable/ic_preview_hide"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/flipCameraButton"
                    style="@style/Widget.PhoneCam.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_flip_camera"
                    android:visibility="gone"
                    app:icon="@drawable/ic_flip"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/leaveButton"
                    style="@style/Widget.PhoneCam.Button.Leave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_leave"
                    android:visibility="gone"
                    app:icon="@drawable/ic_leave"
                    tools:visibility="visible" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
