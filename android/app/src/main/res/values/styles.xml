<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.PhoneCam" parent="@android:style/Widget" />

    <style name="TextAppearance.PhoneCam.Wordmark" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/pc_tungsten</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.PhoneCam.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pc_paper</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.PhoneCam.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pc_mist</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.PhoneCam.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pc_dim</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.PhoneCam.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/pc_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.PhoneCam.Mono" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.PhoneCam.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/pc_tungsten</item>
        <item name="android:textColor">@color/pc_void</item>
        <item name="iconTint">@color/pc_void</item>
        <item name="iconPadding">10dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.PhoneCam.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/pc_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/pc_panel</item>
        <item name="android:textColor">@color/pc_paper</item>
        <item name="iconTint">@color/pc_tungsten</item>
    </style>

    <style name="Widget.PhoneCam.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pc_dim</item>
        <item name="rippleColor">@color/pc_line</item>
    </style>

    <style name="Widget.PhoneCam.Button.Leave" parent="Widget.PhoneCam.Button.Outlined">
        <item name="strokeColor">#5A2A24</item>
        <item name="backgroundTint">#1A1212</item>
        <item name="android:textColor">#F0B4AE</item>
        <item name="iconTint">#F0B4AE</item>
    </style>

    <style name="Widget.PhoneCam.Quality" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/pc_quality_text</item>
        <item name="backgroundTint">@color/pc_quality_bg</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="rippleColor">@color/pc_tungsten_dim</item>
    </style>

    <style name="Widget.PhoneCam.ChipHint" parent="@android:style/Widget.TextView">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.PhoneCam.Caption</item>
        <item name="android:textColor">@color/pc_mist</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
